{
  "manifest_version": 3,
  "name": "GitHub 中文化",
  "description": "GitHub 界面汉化（离线词条）+ 人机翻译（关于/自述/许可证/发行版等长文对照）。支持 Copilot/AI 界面与企业版流程。",
  "version": "1.1.2",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://www.github.com/*",
        "https://gist.github.com/*",
        "https://skills.github.com/*",
        "https://education.github.com/*",
        "https://www.githubstatus.com/*"
      ],
      "js": ["locals.js", "extras.js", "dictionary.js", "content.js", "mt.js"],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
